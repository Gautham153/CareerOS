rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper function to check if the user is signed in
    function isSignedIn() {
      return request.auth != null;
    }
    
    // Helper function to check if the current user is the owner of the document/collection
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    // Global safety net: deny all by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Match users collection and all subcollections recursively
    match /users/{userId} {
      // User can read and write their own profile
      allow read, write: if isOwner(userId);
      
      // Match all nested subcollections under users/{userId}
      match /{allSubcollections=**} {
        allow read, write: if isOwner(userId);
      }
    }
  }
}
